{
  "name": "tab-bill-splitter",
  "private": true,
  "version": "1.0.0",
  "description": "Tab \u2014 split restaurant bills live with friends.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node api.js && node scripts/dev.js",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "migrate": "npm run migrate -w server",
    "build": "node api.js && npm run build -w client",
    "start": "node api.js && npm start -w server",
    "test": "npm test -w server",
    "lint": "npm run lint -w client"
  }
}
